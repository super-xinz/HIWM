# Required by config/chat_with_hiwm_mac.yaml and chat_with_qwen_omni_mac.yaml
# Create a key in Alibaba Cloud Model Studio (Bailian / DashScope), then paste
# it after the equals sign. Never commit the real key.
DASHSCOPE_API_KEY=

# Profile-aware text chat BFF. DeepSeek V4 Flash uses the official
# OpenAI-compatible endpoint; only LLM_API_KEY is secret.
LLM_API_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash
LLM_TIMEOUT_MS=60000

PROFILE_ENGINE_BASE_URL=http://127.0.0.1:8000
PROFILE_ENGINE_API_KEY=local-development-key
PROFILE_ENGINE_TENANT_ID=demo-tenant
PROFILE_ENGINE_TIMEOUT_MS=30000
PROFILE_CONTEXT_MAX_CHARS=8000

# Browser access protection. Required for public deployments; the value is
# verified by the server and is never included in the frontend bundle.
DEMO_ACCESS_CODE=
DEMO_DEFAULT_USER_ID=demo-xu
DEMO_SESSION_TTL_SECONDS=28800
DEMO_COOKIE_SECURE=false

# Chat history storage. On Zeabur, mount a persistent volume at /data and use
# sqlite:////data/companion-chat.db.
COMPANION_DATABASE_URL=sqlite:///./temp/companion-chat.db
GIT_COMMIT_SHA=local
HIWM_COMPANION_ONLY=true
PORT=8283

# Required only when runtime-control endpoints are exposed to non-loopback
# clients. Use a long random value and enter the same value as the Web UI
# access token; loopback-only macOS startup does not require it.
HIWM_RUNTIME_CONTROL_TOKEN=

# Optional TURN service for reliable WebRTC across public networks. Multiple
# URLs are comma-separated, for example turn:turn.example.com:3478,turns:...
HIWM_TURN_URLS=
HIWM_TURN_USERNAME=
HIWM_TURN_CREDENTIAL=

# Optional local runtime overrides. The defaults are shown below.
# HIWM_CONFIG=config/chat_with_hiwm_mac.yaml
# HIWM_HOST=127.0.0.1
# HIWM_PORT=8283
